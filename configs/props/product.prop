# FM
ro.fm.chip=0x6631
ro.fm.band=1
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=1
ro.fm.max_scan_num=40
ro.fm.seek_lev=4
ro.fm.scan_sort=0
ro.fm.short_ana_sup=1
ro.fm.rssi_th_l2=-102
ro.fm.fake_chans=4
ro.fm.fake_chan_0=9210 -205
ro.fm.fake_chan_1=9600 -152
ro.fm.fake_chan_2=10400 -152
ro.fm.fake_chan_3=10750 -205

# LMKD
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=false
ro.lmk.kill_heaviest_task=false
ro.lmk.kill_timeout_ms=1000
ro.lmk.psi_partial_stall_ms=200
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=80
ro.lmk.thrashing_limit_decay=10

# eBPF
ro.bpf.kver_override=5.10.247

# Skia
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
